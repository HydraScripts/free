# Copy to .env and fill in real values.

# Name shown on the landing page and dashboard
SITE_NAME=Hydra Auth

# Port the HTTP server listens on
PORT=3000

# Password for the admin dashboard login
ADMIN_PASSWORD=change-me-please

# Secret used to sign admin session tokens. Use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Public base URL of this service (used in generated loader snippets), no trailing slash
PUBLIC_URL=http://localhost:3000

# Path to the SQLite database file
DB_PATH=./data/whitelist.db
