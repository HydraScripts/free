{
  "name": "ls-rewrite",
  "version": "1.0.0",
  "description": "",
  "main": "server/index.js",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "migrate:api-keys": "node scripts/migrate-api-keys.js",
    "test:redis": "REDIS_URL=${REDIS_URL:-redis://127.0.0.1:6379/15} node --test --test-concurrency=1 tests/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"server/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"server/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "test:lua": "luac5.1 -p client/client.lua && lua5.1 tests/lua/run.lua"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.44.0",
    "dotenv": "^16.0.3",
    "email-validator": "^2.0.4",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "luraph": "^2.0.9",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": ">=20.19"
  }
}
