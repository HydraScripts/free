DATABASE_URL=mongodb+srv://user:password@cluster.example/db
LURAPH_KEY=your_luraph_api_token
ADMIN_KEY=replace_with_a_long_random_value
# Required, >= 32 chars. Keys the HMAC used for license keys (and legacy password hashes).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
LICENSE_HMAC_SECRET=
AUTH_BASE_URL=https://api.example.com
LOADER_BASE_URL=https://api.example.com
# Comma-separated IPs/CIDRs of your reverse proxies (see Fastify trustProxy)
TRUSTED_PROXIES=
PORT=8080
LOG_LEVEL=info
